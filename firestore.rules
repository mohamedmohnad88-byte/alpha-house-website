rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Properties: public read (published), admin full access (password-gated in UI)
    match /properties/{id} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    // Projects
    match /projects/{id} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    // Areas
    match /areas/{id} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    // Inquiries: anyone can create; admin read/update/delete
    match /inquiries/{id} {
      allow create: if true;
      allow read, update, delete: if true;
    }
    // Settings: public read; admin write
    match /settings/{key} {
      allow read: if true;
      allow write: if true;
    }
    // Users: not used (password-gated admin)
    match /users/{uid} {
      allow read, write: if true;
    }
  }
}
